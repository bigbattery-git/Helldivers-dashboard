# Key names only. Real values live in Vercel env vars (`vercel env pull .env.local`).
# Locally, both DB URLs fall back to the Supabase CLI default (`pnpm db:start`).

# Pooled connection for the app (Supavisor transaction pooler, port 6543). Required in production.
DATABASE_URL=
# Direct connection for `prisma migrate` (port 5432).
DIRECT_URL=

# Bearer secret the scheduler sends to /api/collect (ADR 0004).
CRON_SECRET=

# X API bearer token, created by the owner (ADR 0002). Optional: the X feed is hidden without it.
X_BEARER_TOKEN=
