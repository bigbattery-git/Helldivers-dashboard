# Key names only. Real values live in Vercel env vars (`vercel env pull .env.local`).
# Locally, both DB URLs fall back to the Supabase CLI default (`pnpm db:start`).

# Pooled connection for the app (Supavisor transaction pooler, port 6543). Required in production.
DATABASE_URL=
# Direct connection for `prisma migrate` (port 5432).
DIRECT_URL=

# Bearer secret the scheduler sends to /api/collect (ADR 0004).
CRON_SECRET=

# X API bearer token, created by the owner (ADR 0002). Optional: the X feed is hidden without it.
X_BEARER_TOKEN=

# Sentry DSN for server-side error reports (ADR 0005). Optional: nothing is sent without it.
SENTRY_DSN=

# URL pg_net calls for `pnpm db:cron`. Local default reaches the host dev server from the Supabase container.
COLLECT_URL=

# Gemini API free-tier key for machine translation (ADR 0006). Never link billing to its project.
# Optional: untranslated English text is shown without it.
GEMINI_API_KEY=
# Model ID; default gemini-3.5-flash-lite. Older IDs get retired for new users.
GEMINI_MODEL=

# Contact (email) sent as X-Super-Contact to the community API fallback (D-03). Required by that API.
# Optional: without it Arrowhead failures are recorded and no fallback is tried.
COMMUNITY_API_CONTACT=
